# Enforce the engines.node declaration instead of only warning about it.
# The whole point of the pin is that a contributor on the wrong Node gets a
# signal; without this, npm prints an EBADENGINE warning and installs anyway.
#
# This file is per-project on purpose. The root package.json has no "workspaces"
# key, so frontend/, client/, admin/ and mock-linkedin/ are independent npm
# projects: npm resolves the project .npmrc from the nearest package.json
# ancestor, and a root-only .npmrc is NOT read by `cd frontend && npm ci`
# (measured: `npm config get engine-strict` -> false there, true at the root).
engine-strict=true
