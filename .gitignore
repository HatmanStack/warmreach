# Dependencies
node_modules

# Environment
# Generic, so a future .env.production/.env.staging is covered without an edit.
# .env.example is the documented config template and must stay tracked.
.env
.env.*
!.env.example
*.local

# Build output
build
dist
dist-ssr
*.tsbuildinfo
*.zip

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Python
__pycache__/
*.pyc
.venv/

# Editor / IDE
.vscode/*
!.vscode/extensions.json
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.kiro*

# OS
.DS_Store

# Testing / Coverage
coverage/
**/coverage/
.coverage
**/.coverage
linkedin-inspect.log
reports/
# Playwright output. Harmless while the suite needed a hand-started server;
# `npx playwright test` now runs from a clean shell and the CI job uses the html
# reporter, so all three of these appear in a normal working tree.
test-results/
playwright-report/
blob-report/

# uv writes a 52-byte backend/uv.lock that is not a real lock file (backend/
# pyproject.toml is ruff config, with no [project] table) and that nothing
# installs from. It has been committed and reverted once already. The mechanism
# that creates it is still unidentified; ignoring it costs nothing and does not
# depend on the diagnosis being right.
backend/uv.lock

# AWS / Deployment
backend/data
samconfig.toml
backend/samconfig.toml
.deploy-config.json
.ragstack-config.json

# Secrets / Keys
client/.keys/*
mcp-servers.json
docs/*.local.md

# IDE Integration
GEMINI.md
frontend/coverage.json

# Generated API docs (typedoc + mkdocstrings) — built in CI, not committed
docs/api/

# Client runtime output (search links, good/possible connections, profile-init state)
/data/

# Editor / tool backups (e.g. settings.json.bak.<timestamp>)
*.bak*

# Internal planning seed — must never reach the public mirror. Also listed in
# .sync/config.json exclude_paths, because sync.sh rsyncs the working tree and
# does not consult .gitignore.
docs/next-roadmap-seed.md
